# backend/.env.example
# Copy to backend/.env and fill in the values marked <required>.
# Values shown below are the defaults the app uses when a variable is unset.
# Do NOT commit your real .env file — it contains secrets.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# TCP port the Express server listens on.
PORT=4000

# Public base URL of the frontend (used for CORS and OAuth redirect generation).
APP_BASE_URL=http://localhost:5173

# Secret used to sign session cookies. REQUIRED — no default.
APP_SECRET=<required: generate with openssl rand -hex 32>

# SQLite database file path (relative to the process cwd or absolute).
DATABASE_PATH=./data/compliance-monitor.db

# Optional: absolute path to the built frontend dist/ directory.
# When set, the backend serves the SPA from this path (single-origin prod deploy).
# Leave blank in dev (Vite dev server handles the frontend separately).
FRONTEND_DIST=

# ---------------------------------------------------------------------------
# Webex OAuth — user login (integration credentials from developer.webex.com)
# ---------------------------------------------------------------------------

# OAuth integration client ID.
WEBEX_OAUTH_CLIENT_ID=

# OAuth integration client secret. REQUIRED for login to work.
WEBEX_OAUTH_CLIENT_SECRET=<your-oauth-client-secret>

# OAuth redirect URI registered in the Webex integration settings.
WEBEX_OAUTH_REDIRECT_URI=http://localhost:4000/auth/callback

# Space-separated OAuth scopes requested during login.
WEBEX_OAUTH_SCOPES=spark:people_read

# ---------------------------------------------------------------------------
# Webex service app — bot's own Webex identity (service-app credentials)
# ---------------------------------------------------------------------------

# Service app client ID (from developer.webex.com → Service Apps).
WEBEX_SA_CLIENT_ID=

# Service app client secret. REQUIRED for bot API calls to work.
WEBEX_SA_CLIENT_SECRET=<your-service-app-client-secret>

# Long-lived refresh token issued when the service app was authorized.
# Rotate this token periodically per Webex service-app token lifecycle.
WEBEX_SA_REFRESH_TOKEN=<your-service-app-refresh-token>

# ---------------------------------------------------------------------------
# Webex REST API
# ---------------------------------------------------------------------------

# Base URL for ALL Webex REST API calls (OAuth token exchange, people/me,
# service-app token refresh, meetings list, meeting participants).
# Override only for GovCloud or testing against a stub server.
WEBEX_API_BASE=https://webexapis.com/v1

# ---------------------------------------------------------------------------
# Access control — email allowlists
# ---------------------------------------------------------------------------

# Comma-separated list of email addresses granted the "officer" role.
# Emails are lowercased and trimmed. Leave empty to disable officer access.
OFFICER_EMAILS=

# Comma-separated list of email addresses granted the "admin" role.
# Leave empty to disable admin access.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# SIP bot identity (legacy fields — retained for identity/audit continuity)
# ---------------------------------------------------------------------------
# The bot no longer dials out over SIP (see "SDK bot runtime" below): it joins
# via the Webex JS SDK, and the per-meeting join destination is each meeting's
# own registered sipUri, not these values. BOT_DISPLAY_NAME is still the live
# roster/guest-token display name; SIP_LOCAL_URI/SIP_TRANSPORT are kept for
# identity/audit continuity from the SIP-based build.

# Display name shown in the Webex roster (and the SDK guest token identity).
BOT_DISPLAY_NAME=Compliance Monitor Bot

# SIP AoR identifying the bot. NOTE: the per-meeting Webex SIP domain is NOT
# set here — it is taken from each meeting's sipUri at registration time (the
# app is domain-agnostic).
SIP_LOCAL_URI=sip:compliance-bot@localhost

# Legacy SIP transport tag carried on the bot's identity string.
# Valid values: tls | udp | tcp
SIP_TRANSPORT=tls

# --- SDK bot runtime ---
# Loopback dir the bot-page assets are served from (image default is fine).
BOT_PAGE_ASSET_DIR=/app/bot-page
# Headless Chromium path (image default /usr/bin/chromium; empty = Puppeteer bundled).
CHROMIUM_PATH=/usr/bin/chromium
# Disable calendar auto-sync on a parallel/manual stack to avoid double-dialing (default true).
CALENDAR_SYNC_ENABLED=true
# Bot dial retry window. A guest that lands in the meeting lobby needs time for a host to
# admit it before the bot gives up. Backoff is 1,2,4,8,16s then capped at BOT_RETRY_MAX_DELAY_S.
# Defaults (12 attempts, 30s cap) give roughly a 4-minute window; raise BOT_MAX_ATTEMPTS for more.
BOT_MAX_ATTEMPTS=12
BOT_RETRY_MAX_DELAY_S=30
# How the bot receives remote audio:
#   transcoded  = one server-mixed audio stream (simple, no video decode) — preferred, default
#   multistream = per-speaker streams mixed locally; REQUIRES receiving video (heavier). Use this
#                 if your SDK version has dropped transcoded mode (proven fallback).
BOT_MEDIA_MODE=transcoded
# Label the bot's Webex guest identity is built from. Each bot's `subject` is this prefix
# plus a digest of its meeting id, so concurrent bots never share one Webex device
# registration. Non-[a-z0-9] characters are folded to '-' and the prefix is truncated to
# fit a 64-char subject.
# OPERATIONS: this is the fleet-wide rotation lever. Because the subject is DERIVED, a
# guest user Webex has wedged is re-derived identically on every retry and the bot fails
# forever; changing this prefix re-derives every bot's guest identity and is how you
# escape a poisoned guest user. To rotate ONE meeting instead, re-register it — a new row
# is a new uuid, hence a new subject.
WEBEX_GUEST_SUBJECT_PREFIX=compliance-bot

# ---------------------------------------------------------------------------
# Webex account integration — calendar sync, live roster, solitude
# ---------------------------------------------------------------------------
# OPS PREREQUISITE (one-time, at deploy): create the Service App on
# developer.webex.com, have an ORG ADMIN authorize it, then fill in the
# WEBEX_SA_* values above. The refresh token in env is a BOOTSTRAP only —
# after the first refresh the rotated token is persisted in sqlite
# (service_tokens table) and takes precedence.
# When WEBEX_SA_CLIENT_ID / WEBEX_SA_CLIENT_SECRET / WEBEX_SCHEDULER_EMAIL are
# empty, the integration is LOUDLY disabled and GET /meetings reports
# webex_integration: "failed".

# The single Webex account all chaperoned meetings are scheduled on.
# Sent as hostEmail on every admin-scoped Webex call. REQUIRED for the Webex account integration.
WEBEX_SCHEDULER_EMAIL=

# Comma-separated email domains classified as front-office ('fo') in the
# roster. Other authenticated attendees -> 'analyst'; unauthenticated guests
# -> 'other'; the bot's own entry -> 'bot'. REQUIRED for the Webex account integration.
INTERNAL_EMAIL_DOMAINS=

# Calendar poll cadence in seconds (Webex meetings list API).
CALENDAR_SYNC_INTERVAL_S=300

# Upcoming look-ahead window in hours.
CALENDAR_WINDOW_H=24

# Participant poll cadence per active meeting, in seconds.
ROSTER_POLL_INTERVAL_S=20

# Bot-alone grace period before solitude auto-hangup, in seconds.
# NOTE: 0 does NOT disable solitude — it makes the bot hang up on the first poll
# where it is alone, which (with join-before-host) can end monitoring before any
# human joins. Use a large value if you effectively want it off.
SOLITUDE_TIMEOUT_S=600
